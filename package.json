{
  "name": "@chrissgon/perfectui-mcp",
  "version": "0.1.0",
  "description": "A read-only MCP server that answers questions about Perfect UI 1.0.0 from its own documentation and stylesheet.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "author": "Christopher Gonçalves",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "corpus": "tsx scripts/build-corpus.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "minisearch": "7.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.8.0",
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
