{
  "name": "@chrissgon/perfectui-mcp",
  "version": "0.2.0",
  "description": "A read-only MCP server that answers questions about Perfect UI 1.0.0 from its own documentation and stylesheet, as a stdio bin and as a library for other transports.",
  "license": "MIT",
  "type": "module",
  "author": "Christopher Gonçalves",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrissgon/perfectui-agents.git"
  },
  "homepage": "https://github.com/chrissgon/perfectui-agents#readme",
  "bugs": {
    "url": "https://github.com/chrissgon/perfectui-agents/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "perfectui",
    "css",
    "agents"
  ],
  "bin": {
    "perfectui-mcp": "dist/server.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "corpus": "tsx scripts/build-corpus.ts",
    "start": "node dist/server.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "minisearch": "7.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.8.0",
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
